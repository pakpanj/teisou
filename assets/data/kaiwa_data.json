      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Jawab air putih saja, tidak apa-apa",
        "acceptedAnswers": [
          {
            "japanese": "お水で大丈夫です。",
            "romaji": "Omizu de daijoubu desu.",
            "translation": "Air putih saja, tidak apa-apa.",
            "variants": [
              "水で大丈夫です。",
              "お水をお願いします。"
            ],
            "expressionTag": null
          }
        ],
        "note": null
      },
      {
        "id": "5",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "少々お待ちください。",
          "romaji": "Shoushou omachi kudasai.",
          "translation": "Mohon tunggu sebentar."
        },
        "note": null
      }
    ]
  },
