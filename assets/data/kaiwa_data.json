[
  {
    "id": "kaiwa_kenalan_teman_baru",
    "title": "Berkenalan dengan Teman Baru",
    "category": "perkenalan",
    "description": "Yuki menyapa dan berkenalan denganmu untuk pertama kalinya.",
    "lines": [
      {
        "id": "1",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "はじめまして。ゆきです。",
          "romaji": "Hajimemashite. Yuki desu.",
          "translation": "Salam kenal. Saya Yuki."
        },
        "note": "はじめまして dipakai khusus saat bertemu seseorang untuk pertama kali."
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Balas salam ini dan sebutkan namamu (Budi)",
        "acceptedAnswers": [
          {
            "japanese": "はじめまして。ブディです。よろしくお願いします。",
            "romaji": "Hajimemashite. Budi desu. Yoroshiku onegaishimasu.",
            "translation": "Salam kenal. Saya Budi. Mohon bantuannya.",
            "variants": [
              "はじめまして、ブディです。よろしくお願いします。"
            ],
            "expressionTag": "sopan"
          },
          {
            "japanese": "はじめまして。ブディです。",
            "romaji": "Hajimemashite. Budi desu.",
            "translation": "Salam kenal. Saya Budi.",
            "variants": [
              "はじめまして、ブディです。"
            ],
            "expressionTag": null
          }
        ],
        "note": null
      },
      {
        "id": "3",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "よろしくお願いします！ブディさんは学生ですか。",
          "romaji": "Yoroshiku onegaishimasu! Budi-san wa gakusei desu ka.",
          "translation": "Senang berkenalan! Budi apakah kamu pelajar?"
        },
        "note": null
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Jawab bahwa kamu pelajar (gakusei)",
        "acceptedAnswers": [
          {
            "japanese": "はい、学生です。",
            "romaji": "Hai, gakusei desu.",
            "translation": "Ya, saya pelajar.",
            "variants": [
              "学生です。",
              "はい学生です。"
            ],
            "expressionTag": null
          }
        ],
        "note": null
      },
      {
        "id": "5",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "そうですか！日本語の勉強、頑張ってくださいね。",
          "romaji": "Sou desu ka! Nihongo no benkyou, ganbatte kudasai ne.",
          "translation": "Begitu ya! Semangat belajar bahasa Jepangnya ya."
        },
        "note": null
      },
      {
        "id": "6",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Balas dengan semangat bahwa kamu akan berusaha",
        "acceptedAnswers": [
          {
            "japanese": "頑張ります！",
            "romaji": "Ganbarimasu!",
            "translation": "Saya akan berusaha!",
            "variants": [
              "頑張ります。",
              "はい、頑張ります。"
            ],
            "expressionTag": "semangat"
          }
        ],
        "note": "頑張ります adalah ungkapan umum untuk menunjukkan semangat/tekad, sering dipakai saat menerima dukungan atau memulai sesuatu."
      },
      {
        "id": "7",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "それでは、また今度ね！",
          "romaji": "Sore dewa, mata kondo ne!",
          "translation": "Kalau begitu, sampai jumpa lagi ya!"
        },
        "note": null
      }
    ]
  },
  {
    "id": "kaiwa_sapa_pagi_hari",
    "title": "Menyapa di Pagi Hari",
    "category": "perkenalan",
    "description": "Pak Tanaka, tetanggamu, menyapamu di pagi hari sebelum berangkat sekolah.",
    "lines": [
      {
        "id": "1",
        "speaker": "Pak Tanaka",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "おはようございます。今日もいい天気ですね。",
          "romaji": "Ohayou gozaimasu. Kyou mo ii tenki desu ne.",
          "translation": "Selamat pagi. Hari ini cuacanya bagus juga ya."
        },
        "note": null
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Balas salam pagi ini",
        "acceptedAnswers": [
          {
            "japanese": "おはようございます。",
            "romaji": "Ohayou gozaimasu.",
            "translation": "Selamat pagi.",
            "variants": [
              "おはようございます!"
            ],
            "expressionTag": null
          }
        ],
        "note": null
      },
      {
        "id": "3",
        "speaker": "Pak Tanaka",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "これから学校ですか。",
          "romaji": "Kore kara gakkou desu ka.",
          "translation": "Mau berangkat sekolah sekarang?"
        },
        "note": null
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Jawab iya, benar",
        "acceptedAnswers": [
          {
            "japanese": "はい、そうです。",
            "romaji": "Hai, sou desu.",
            "translation": "Ya, benar.",
            "variants": [
              "はい。",
              "そうです。"
            ],
            "expressionTag": null
          }
        ],
        "note": null
      },
      {
        "id": "5",
        "speaker": "Pak Tanaka",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "気をつけて行ってらっしゃい。",
          "romaji": "Ki wo tsukete itterasshai.",
          "translation": "Hati-hati, selamat berangkat."
        },
        "note": null
      },
      {
        "id": "6",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Balas dengan ungkapan saat berangkat dari rumah",
        "acceptedAnswers": [
          {
            "japanese": "行ってきます。",
            "romaji": "Itte kimasu.",
            "translation": "Saya berangkat (akan kembali).",
            "variants": [],
            "expressionTag": null
          }
        ],
        "note": "行ってきます diucapkan orang yang akan keluar rumah; dijawab lawan bicara dengan 行ってらっしゃい."
      }
    ]
  },
  {
    "id": "kaiwa_tanya_asal_negara",
    "title": "Menanyakan Asal Negara",
    "category": "perkenalan",
    "description": "Sari bertanya tentang asal negaramu dan makanan favorit di sana.",
    "lines": [
      {
        "id": "1",
        "speaker": "Sari",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "ブディさんはどこの国から来ましたか。",
          "romaji": "Budi-san wa doko no kuni kara kimashita ka.",
          "translation": "Budi berasal dari negara mana?"
        },
        "note": null
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Jawab bahwa kamu datang dari Indonesia",
        "acceptedAnswers": [
          {
            "japanese": "インドネシアから来ました。",
            "romaji": "Indonesia kara kimashita.",
            "translation": "Saya datang dari Indonesia.",
            "variants": [
              "インドネシアです。",
              "インドネシア出身です。"
            ],
            "expressionTag": null
          }
        ],
        "note": null
      },
      {
        "id": "3",
        "speaker": "Sari",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "そうなんですね！インドネシア料理は好きですか。",
          "romaji": "Sou nan desu ne! Indonesia ryouri wa suki desu ka.",
          "translation": "Oh begitu! Apakah kamu suka masakan Indonesia?"
        },
        "note": null
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "promptHint": "Jawab bahwa kamu suka",
        "acceptedAnswers": [
          {
            "japanese": "はい、好きです。",
            "romaji": "Hai, suki desu.",
            "translation": "Ya, saya suka.",
            "variants": [
              "好きです。"
            ],
            "expressionTag": "senang"
          }
        ],
        "note": null
      },
      {
        "id": "5",
        "speaker": "Sari",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "私も食べてみたいです！",
          "romaji": "Watashi mo tabete mitai desu!",
          "translation": "Saya juga ingin coba makan itu!"
        },
        "note": null
      }
    ]
  },
  {
    "id": "kaiwa_pesan_makanan",
