[
  {
    "id": "kaiwa_kenalan_teman_baru",
    "title": "Berkenalan dengan Teman Baru",
    "category": "perkenalan",
    "description": "Yuki menyapa dan berkenalan denganmu untuk pertama kalinya.",
    "lines": [
      {
        "id": "1",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "はじめまして。ゆきです。",
          "romaji": "Hajimemashite. Yuki desu.",
          "translation": "Salam kenal. Saya Yuki."
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_kenalan_teman_baru_1.png"
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "はじめまして。ブディです。よろしくお願いします。",
            "romaji": "Hajimemashite. Budi desu. Yoroshiku onegaishimasu.",
            "translation": "Salam kenal. Saya Budi. Mohon bantuannya.",
            "isCorrect": true,
            "expressionTag": "sopan"
          },
          {
            "japanese": "さようなら。",
            "romaji": "Sayounara.",
            "translation": "Selamat tinggal.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "いただきます。",
            "romaji": "Itadakimasu.",
            "translation": "Selamat makan.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "3",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "よろしくお願いします！ブディさんは学生ですか。",
          "romaji": "Yoroshiku onegaishimasu! Budi-san wa gakusei desu ka.",
          "translation": "Senang berkenalan! Budi apakah kamu pelajar?"
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_kenalan_teman_baru_3.png"
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "はい、学生です。",
            "romaji": "Hai, gakusei desu.",
            "translation": "Ya, saya pelajar.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "猫が好きです。",
            "romaji": "Neko ga suki desu.",
            "translation": "Saya suka kucing.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "学校はどこですか。",
            "romaji": "Gakkou wa doko desu ka.",
            "translation": "Di mana sekolahnya?",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "5",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "そうですか！日本語の勉強、頑張ってくださいね。",
          "romaji": "Sou desu ka! Nihongo no benkyou, ganbatte kudasai ne.",
          "translation": "Begitu ya! Semangat belajar bahasa Jepangnya ya."
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_kenalan_teman_baru_5.png"
      },
      {
        "id": "6",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "頑張ります！",
            "romaji": "Ganbarimasu!",
            "translation": "Saya akan berusaha!",
            "isCorrect": true,
            "expressionTag": "semangat"
          },
          {
            "japanese": "すみません。",
            "romaji": "Sumimasen.",
            "translation": "Maaf/permisi.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "いいえ、違います。",
            "romaji": "Iie, chigaimasu.",
            "translation": "Bukan, itu salah.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "7",
        "speaker": "Yuki",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "それでは、また今度ね！",
          "romaji": "Sore dewa, mata kondo ne!",
          "translation": "Kalau begitu, sampai jumpa lagi ya!"
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_kenalan_teman_baru_7.png"
      }
    ]
  },
  {
    "id": "kaiwa_sapa_pagi_hari",
    "title": "Menyapa di Pagi Hari",
    "category": "perkenalan",
    "description": "Pak Tanaka, tetanggamu, menyapamu di pagi hari sebelum berangkat sekolah.",
    "lines": [
      {
        "id": "1",
        "speaker": "Pak Tanaka",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "おはようございます。今日もいい天気ですね。",
          "romaji": "Ohayou gozaimasu. Kyou mo ii tenki desu ne.",
          "translation": "Selamat pagi. Hari ini cuacanya bagus juga ya."
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_sapa_pagi_hari_1.png"
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "おはようございます。",
            "romaji": "Ohayou gozaimasu.",
            "translation": "Selamat pagi.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "おやすみなさい。",
            "romaji": "Oyasumi nasai.",
            "translation": "Selamat malam (sebelum tidur).",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "こんばんは。",
            "romaji": "Konbanwa.",
            "translation": "Selamat malam.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "3",
        "speaker": "Pak Tanaka",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "これから学校ですか。",
          "romaji": "Kore kara gakkou desu ka.",
          "translation": "Mau berangkat sekolah sekarang?"
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_sapa_pagi_hari_3.png"
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "はい、そうです。",
            "romaji": "Hai, sou desu.",
            "translation": "Ya, benar.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "いいえ、家にいます。",
            "romaji": "Iie, ie ni imasu.",
            "translation": "Tidak, saya di rumah.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "何ですか。",
            "romaji": "Nan desu ka.",
            "translation": "Apa?",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "5",
        "speaker": "Pak Tanaka",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "気をつけて行ってらっしゃい。",
          "romaji": "Ki wo tsukete itterasshai.",
          "translation": "Hati-hati, selamat berangkat."
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_sapa_pagi_hari_5.png"
      },
      {
        "id": "6",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "行ってきます。",
            "romaji": "Itte kimasu.",
            "translation": "Saya berangkat (akan kembali).",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "ただいま。",
            "romaji": "Tadaima.",
            "translation": "Saya pulang.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "おかえりなさい。",
            "romaji": "Okaerinasai.",
            "translation": "Selamat datang kembali.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      }
    ]
  },
  {
    "id": "kaiwa_tanya_asal_negara",
    "title": "Menanyakan Asal Negara",
    "category": "perkenalan",
    "description": "Sari bertanya tentang asal negaramu dan makanan favorit di sana.",
    "lines": [
      {
        "id": "1",
        "speaker": "Sari",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "ブディさんはどこの国から来ましたか。",
          "romaji": "Budi-san wa doko no kuni kara kimashita ka.",
          "translation": "Budi berasal dari negara mana?"
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_tanya_asal_negara_1.png"
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "インドネシアから来ました。",
            "romaji": "Indonesia kara kimashita.",
            "translation": "Saya datang dari Indonesia.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "二十歳です。",
            "romaji": "Hatachi desu.",
            "translation": "Saya berusia 20 tahun.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "元気です。",
            "romaji": "Genki desu.",
            "translation": "Saya baik-baik saja.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "3",
        "speaker": "Sari",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "そうなんですね！インドネシア料理は好きですか。",
          "romaji": "Sou nan desu ne! Indonesia ryouri wa suki desu ka.",
          "translation": "Oh begitu! Apakah kamu suka masakan Indonesia?"
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_tanya_asal_negara_3.png"
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "はい、好きです。",
            "romaji": "Hai, suki desu.",
            "translation": "Ya, saya suka.",
            "isCorrect": true,
            "expressionTag": "senang"
          },
          {
            "japanese": "いいえ、忙しいです。",
            "romaji": "Iie, isogashii desu.",
            "translation": "Tidak, saya sibuk.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "分かりません。",
            "romaji": "Wakarimasen.",
            "translation": "Saya tidak mengerti.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "5",
        "speaker": "Sari",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "私も食べてみたいです！",
          "romaji": "Watashi mo tabete mitai desu!",
          "translation": "Saya juga ingin coba makan itu!"
        },
        "imagePath": "kaiwa_images/perkenalan/kaiwa_tanya_asal_negara_5.png"
      }
    ]
  },
  {
    "id": "kaiwa_pesan_makanan",
    "title": "Memesan Makanan di Restoran",
    "category": "restoran",
    "description": "Kamu memesan makanan dan minuman ke pelayan restoran.",
    "lines": [
      {
        "id": "1",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "いらっしゃいませ！ご注文はお決まりですか。",
          "romaji": "Irasshaimase! Gochuumon wa okimari desu ka.",
          "translation": "Selamat datang! Sudah menentukan pesanan?"
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_pesan_makanan_1.png"
      },
      {
        "id": "2",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "ラーメンをお願いします。",
            "romaji": "Raamen wo onegaishimasu.",
            "translation": "Tolong pesanan ramen.",
            "isCorrect": true,
            "expressionTag": "sopan"
          },
          {
            "japanese": "トイレはどこですか。",
            "romaji": "Toire wa doko desu ka.",
            "translation": "Di mana toilet?",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "いくらですか。",
            "romaji": "Ikura desu ka.",
            "translation": "Berapa harganya?",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "3",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "かしこまりました。お飲み物はいかがですか。",
          "romaji": "Kashikomarimashita. Onomimono wa ikaga desu ka.",
          "translation": "Baik. Bagaimana dengan minumannya?"
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_pesan_makanan_3.png"
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "お水で大丈夫です。",
            "romaji": "Omizu de daijoubu desu.",
            "translation": "Air putih saja, tidak apa-apa.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "ラーメンをお願いします。",
            "romaji": "Raamen wo onegaishimasu.",
            "translation": "Tolong pesanan ramen.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "美味しいです。",
            "romaji": "Oishii desu.",
            "translation": "Enak.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "5",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "少々お待ちください。",
          "romaji": "Shoushou omachi kudasai.",
          "translation": "Mohon tunggu sebentar."
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_pesan_makanan_5.png"
      }
    ]
  },
  {
    "id": "kaiwa_minta_bill",
    "title": "Meminta Bill / Membayar",
    "category": "restoran",
    "description": "Kamu selesai makan dan ingin membayar.",
    "lines": [
      {
        "id": "1",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "すみません、お会計をお願いします。",
            "romaji": "Sumimasen, okaikei wo onegaishimasu.",
            "translation": "Permisi, tolong bill-nya.",
            "isCorrect": true,
            "expressionTag": "sopan"
          },
          {
            "japanese": "いただきます。",
            "romaji": "Itadakimasu.",
            "translation": "Selamat makan.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "ごちそうさまでした。",
            "romaji": "Gochisousama deshita.",
            "translation": "Terima kasih atas makanannya.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "2",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "はい、少々お待ちください。",
          "romaji": "Hai, shoushou omachi kudasai.",
          "translation": "Baik, mohon tunggu sebentar."
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_minta_bill_2.png"
      },
      {
        "id": "3",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "お待たせしました。1,200円になります。",
          "romaji": "Omataseshimashita. Sen nihyaku en ni narimasu.",
          "translation": "Maaf menunggu. Totalnya 1.200 yen."
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_minta_bill_3.png"
      },
      {
        "id": "4",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "カードでお願いします。",
            "romaji": "Kaado de onegaishimasu.",
            "translation": "Tolong dengan kartu.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "現金がありません。",
            "romaji": "Genkin ga arimasen.",
            "translation": "Saya tidak punya uang tunai.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "おいしかったです。",
            "romaji": "Oishikatta desu.",
            "translation": "Tadi enak.",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "5",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "かしこまりました。ありがとうございました。",
          "romaji": "Kashikomarimashita. Arigatou gozaimashita.",
          "translation": "Baik. Terima kasih banyak."
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_minta_bill_5.png"
      }
    ]
  },
  {
    "id": "kaiwa_menu_rekomendasi",
    "title": "Menanyakan Menu Rekomendasi",
    "category": "restoran",
    "description": "Kamu bingung mau pesan apa dan bertanya rekomendasi ke pelayan.",
    "lines": [
      {
        "id": "1",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "おすすめは何ですか。",
            "romaji": "Osusume wa nan desu ka.",
            "translation": "Apa yang direkomendasikan?",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "これは何ですか。",
            "romaji": "Kore wa nan desu ka.",
            "translation": "Ini apa?",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "何時に開きますか。",
            "romaji": "Nanji ni akimasu ka.",
            "translation": "Jam berapa buka?",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "2",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "カレーが人気です。",
          "romaji": "Kare ga ninki desu.",
          "translation": "Kari sedang populer."
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_menu_rekomendasi_2.png"
      },
      {
        "id": "3",
        "speaker": "Anda",
        "isUserTurn": true,
        "options": [
          {
            "japanese": "それにします。",
            "romaji": "Sore ni shimasu.",
            "translation": "Kalau begitu saya pesan itu.",
            "isCorrect": true,
            "expressionTag": null
          },
          {
            "japanese": "それは要りません。",
            "romaji": "Sore wa irimasen.",
            "translation": "Saya tidak butuh itu.",
            "isCorrect": false,
            "expressionTag": null
          },
          {
            "japanese": "いつ来ますか。",
            "romaji": "Itsu kimasu ka.",
            "translation": "Kapan datang?",
            "isCorrect": false,
            "expressionTag": null
          }
        ]
      },
      {
        "id": "4",
        "speaker": "Pelayan",
        "isUserTurn": false,
        "npcLine": {
          "japanese": "かしこまりました！",
          "romaji": "Kashikomarimashita!",
          "translation": "Baik!"
        },
        "imagePath": "kaiwa_images/restoran/kaiwa_menu_rekomendasi_4.png"
      }
    ]
  }
]