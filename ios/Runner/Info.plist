<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kana Master</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>kana_master</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Google Sign-In callback. This is REVERSED_CLIENT_ID copied verbatim
	     from GoogleService-Info.plist, and it must stay in step with
	     `iosClientId` in lib/firebase_options.dart: iOS hands control back
	     to whichever app claims this URL scheme, so without it the Google
	     sign-in sheet opens, the user signs in, and then nothing happens —
	     it never returns to the app. Android needs no equivalent; it
	     matches by package name + SHA fingerprint instead. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.329692614759-kohqu6a6mvs39jg7fi9maj30usdiqdrl</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Teisou membutuhkan akses kamera untuk fitur pemindaian teks Jepang (Cam Detector).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Teisou membutuhkan akses galeri foto untuk memilih foto profil kamu.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Real AdMob App ID for "Teisou Kana Master" (iOS). Required:
	     google_mobile_ads throws on initialize() if this key is missing, so
	     a build without it crashes at startup rather than merely showing no
	     ads.

	     This is a *different* id from the Android one in
	     AndroidManifest.xml — AdMob treats each platform as its own app —
	     and the same account also holds an unrelated app called Cash
	     Teisou, so check both the platform and the app name before pasting.
	     Note the tilde: ad *unit* ids use a slash and are not the same
	     thing. -->
	<!-- Answers the export-compliance question once here instead of once
	     per submission. False is the right answer for an app whose only
	     encryption is the HTTPS its networking libraries do for it, which
	     is exempt; nothing here implements or bundles its own crypto.
	     Without this key App Store Connect asks the same question by hand
	     on every upload and holds the build until it is answered. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-7168330620893919~8289431398</string>
	<!-- SKAdNetworkItems is deliberately absent. It affects install
	     attribution, not whether ads serve, and the buyer list is long,
	     changes over time, and must be copied verbatim from Google's own
	     AdMob iOS documentation — inventing entries from memory would be
	     worse than leaving it out. Paste the current list here before
	     release. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
