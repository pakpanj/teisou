rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatar upload — hanya pemilik akun yang bisa baca/tulis avatarnya
    // sendiri. Publicly readable download URLs are handed out by Firebase
    // once uploaded; this rule only governs direct Storage access.
    // Storage Rules (unlike Firestore Rules) can't mix a wildcard capture
    // with a literal suffix in one path segment (`{uid}.jpg` is invalid
    // syntax) — capture the whole filename instead and compare it as a
    // string in the rule body.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Kotoba vocab illustrations — publicly readable (matches the download
    // URLs Firebase hands out once uploaded); uploads only via the Firebase
    // Console/Admin SDK, which bypasses these rules entirely, so write is
    // always denied here.
    match /kotoba_images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Kaiwa dialogue illustrations — same read-only shape as kotoba_images
    // above. This was missing when the Kaiwa image+multiple-choice redesign
    // shipped (no images had been uploaded yet, so the gap was invisible
    // until upload time); added so real images work under the default-deny
    // rule as soon as they're uploaded, instead of every KaiwaImage silently
    // falling back to its placeholder forever.
    match /kaiwa_images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Explicit catch-all: anything not matched above is denied. Firebase
    // Storage already default-denies unmatched paths, but this makes that
    // fact visible in the rules file itself rather than implicit.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
