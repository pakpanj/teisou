<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used by every launcher from Android 8 onwards.
     Without this the legacy square PNG gets a white plate drawn around it
     on most modern launchers, which looks like a bug rather than a
     choice. Both layers are generated by scripts/generate_app_icon.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
