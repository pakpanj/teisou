rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users — hanya bisa akses data sendiri. Dokumen users/{uid} sendiri
    // (bukan subcollection-nya) punya satu pengecekan tambahan: tidak boleh
    // MENGUBAH avatarType menjadi preset_premium/custom_upload kecuali
    // tier langganan saat ini memang premium — ini menegakkan di server
    // apa yang sebelumnya cuma dicek di UI (AvatarPickerSheet), supaya
    // client yang menulis langsung ke Firestore tidak bisa melewati gate
    // premium. Sengaja hanya memblokir saat avatarType BERUBAH menjadi
    // tergated (bukan tiap kali dokumen ditulis) — supaya user yang sudah
    // pernah pasang avatar premium lalu langganannya berakhir tidak
    // mendadak gagal menulis hal lain yang tidak berkaitan sama sekali.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
          && isAllowedAvatarWrite();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Leaderboard — semua bisa baca, hanya bisa tulis data sendiri
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Clans — siapa saja yang login bisa baca (cari lewat kode join, lihat
    // ranking anggota). Membuat clan hanya boleh kalau hostUid == diri
    // sendiri. Mengubah dokumen clan setelah dibuat hanya boleh oleh host
    // (mis. nanti kalau ada fitur rename), KECUALI perubahan yang hanya
    // menyentuh `memberCount` — itu yang dilakukan siapa pun saat
    // join/leaveClan menaikkan/menurunkan hitungan anggota.
    match /clans/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
          && (resource.data.hostUid == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Roster — siapa saja yang login bisa baca daftar anggota, tapi
      // setiap orang hanya bisa menulis/menghapus baris miliknya sendiri
      // (uid dokumen == uid yang login) — mencegah orang lain mendaftarkan
      // atau mengeluarkan anggota atas nama orang lain.
      match /members/{memberUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == memberUid;
      }
    }

    function isAllowedAvatarWrite() {
      let oldType = resource == null
          ? 'google'
          : resource.data.get('profile', {}).get('avatarType', 'google');
      let newType = request.resource.data.get('profile', {}).get('avatarType', 'google');
      let changingToGated = newType != oldType
          && (newType == 'preset_premium' || newType == 'custom_upload');
      let currentTier = resource == null
          ? 'free'
          : resource.data.get('subscription', {}).get('tier', 'free');
      return !changingToGated || currentTier == 'premium';
    }
  }
}
