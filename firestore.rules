rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // `appConfig/minVersion` — dibaca oleh `MinVersionGate` (Dart:
    // `lib/features/onboarding/min_version_gate.dart`), gate PALING
    // AWAL di startup chain, sebelum sign-in anonim sekalipun terjadi.
    // Karena itu ini SATU-SATUNYA dokumen di seluruh ruleset ini yang
    // boleh dibaca tanpa `request.auth != null` — setiap collection lain
    // di bawah baris ini tetap mensyaratkan auth seperti biasa.
    //
    // Sengaja `match /appConfig/minVersion` (nama dokumen persis), BUKAN
    // `match /appConfig/{doc}` — kalau `appConfig` kelak menampung
    // dokumen lain yang tidak boleh publik, wildcard di sini akan diam-
    // diam ikut membukanya. Path spesifik berarti dokumen baru di bawah
    // `appConfig/` tetap default-deny sampai ada blok match-nya sendiri.
    //
    // Tidak ada jalur tulis dari client sama sekali — nilainya diisi
    // manual lewat Firebase Console, bukan dari kode aplikasi atau Cloud
    // Function mana pun.
    match /appConfig/minVersion {
      allow read: if true;
      allow write: if false;
    }

    // Users — hanya bisa akses data sendiri. Dokumen users/{uid} sendiri
    // (bukan subcollection-nya) punya satu pengecekan tambahan: tidak boleh
    // MENGUBAH avatarType menjadi preset_premium/custom_upload kecuali
    // tier langganan saat ini memang premium — ini menegakkan di server
    // apa yang sebelumnya cuma dicek di UI (AvatarPickerSheet), supaya
    // client yang menulis langsung ke Firestore tidak bisa melewati gate
    // premium. Sengaja hanya memblokir saat avatarType BERUBAH menjadi
    // tergated (bukan tiap kali dokumen ditulis) — supaya user yang sudah
    // pernah pasang avatar premium lalu langganannya berakhir tidak
    // mendadak gagal menulis hal lain yang tidak berkaitan sama sekali.
    //
    // Pengecekan kedua: `cardGameRank` (tingkat/divisi/bintang Mode Game
    // Card) TIDAK BOLEH diubah oleh client sama sekali — satu-satunya
    // penulisnya adalah Cloud Function `onBattleMatchConcluded`
    // (functions/battle_stars.js), yang jalan dengan hak Admin SDK
    // sehingga tidak tunduk pada aturan ini. Tanpa kunci ini seluruh
    // tangga bintang cuma hiasan: siapa pun bisa menulis langsung ke
    // dokumennya sendiri dan jadi Emerald tanpa bertanding sekali pun.
    // Sengaja dibandingkan nilai sebelum vs. sesudah (bukan melarang
    // field-nya muncul), karena penulisan lain ke dokumen ini memakai
    // set(merge:true) — field yang tidak disebut tetap ikut terbawa di
    // request.resource.data, jadi larangan "tidak boleh ada" akan
    // memblokir penyimpanan nama/avatar yang tidak ada hubungannya.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
          && isAllowedAvatarWrite()
          && !('cardGameRank' in request.resource.data)
          // Dokumen baru boleh membawa langganan 'free' bawaan
          // ProgressRepository.ensureUserProfile, tidak boleh lebih.
          && request.resource.data.get('subscription', {})
              .get('tier', 'free') == 'free'
          && !('entitlements' in request.resource.data)
          && request.resource.data.get('coins', 0) == 0
          && !('adRewards' in request.resource.data)
          && !('xp' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
          && isAllowedAvatarWrite()
          && isAllowedProfileWrite()
          && isAllowedCardSkinWrite()
          && isAllowedPurchaseWrite()
          && request.resource.data.get('cardGameRank', null)
              == resource.data.get('cardGameRank', null);
      // Sengaja tidak ada `allow delete` — tidak ada fitur aplikasi yang
      // pernah menghapus dokumen `users/{uid}` sendiri, dan sebelum rule
      // Mode Game Card ditambahkan di atas, ini memang sudah terblokir
      // secara tidak sengaja (rule lama satu `allow write` yang menyentuh
      // `request.resource.data` lewat `isAllowedAvatarWrite()`, yang
      // bernilai null pada delete sehingga selalu gagal). Menulis ulang
      // sebagai create/update/tanpa-delete di sini menjaga perilaku itu
      // secara sengaja, bukan lagi kebetulan.
      //
      // **Security & Monetization Remediation, Phase 3 — Recursive
      // Wildcard Bypass (celah kritis, ditemukan lewat
      // firestore_rules_tests/, real Firestore Rules Emulator).**
      // Versi lama di sini adalah `match /{document=**} { allow read,
      // write: if owner; } }` LANGSUNG di bawah `match /users/{uid}`.
      // Firestore's recursive wildcard (`{name=**}`) mencocokkan NOL
      // ATAU LEBIH segmen path — jadi blok itu bukan cuma mencocokkan
      // subcollection `users/{uid}/apa saja`, tapi JUGA dokumen
      // `users/{uid}` itu sendiri (dengan nol segmen tersisa). Firestore
      // rules meng-UNION semua blok yang cocok pada satu path — jadi
      // grant longgar "boleh tulis apa saja" dari blok wildcard ini
      // otomatis berlaku juga untuk `users/{uid}` sendiri, membuat
      // SELURUH pembatasan di `allow create`/`allow update` di atas
      // (adRewards, xp, avatar/frame/cover/card-skin ownership,
      // cardGameRank, subscription/entitlements/coins) bisa dilewati
      // begitu saja lewat satu `updateDoc` langsung ke dokumen
      // `users/{uid}` — dibuktikan lewat
      // firestore_rules_tests/wildcard_probe.test.js sebelum diperbaiki
      // di sini.
      //
      // **Perbaikan**: sisipkan satu segmen path bernama WAJIB
      // (`{subcollection}`) sebelum wildcard rekursif. Firestore Rules
      // tidak punya sintaks "satu atau lebih segmen" langsung, tapi
      // menamai satu segmen tetap lalu baru wildcard rekursif di
      // bawahnya adalah idiom resmi untuk maksud yang sama:
      // `{subcollection}` WAJIB cocok dengan tepat satu segmen (nama
      // subcollection, mis. `friends`, `clanInvites`, `kanjiProgress`),
      // dan dokumen `users/{uid}` sendiri (nol segmen tersisa setelah
      // `/users/{uid}`) tidak pernah punya segmen itu untuk dicocokkan
      // — jadi blok ini sekarang HANYA mencocokkan sesuatu yang
      // benar-benar berada DI DALAM sebuah subcollection, tidak pernah
      // dokumen induknya sendiri. `{document=**}` di bawah
      // `{subcollection}` tetap boleh nol atau lebih segmen — itu
      // sengaja, supaya dokumen langsung di dalam satu subcollection
      // (`users/{uid}/friends/{friendUid}`) MAUPUN yang lebih dalam
      // lagi (kalau suatu saat ada) tetap tercakup sama seperti
      // sebelumnya. Cakupan izin (siapa boleh baca/tulis) sama sekali
      // tidak berubah — hanya PATH yang dicocokkan yang dipersempit
      // supaya tidak lagi menyentuh `users/{uid}` itu sendiri.
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Kunci jawaban ujian lompat rank. TIDAK BOLEH dibaca maupun
    // ditulis client sama sekali — hanya Cloud Function
    // startRankSkipExam/submitRankSkipExam (rank_skip.js) yang
    // menyentuhnya, lewat Admin SDK yang tidak tunduk pada aturan ini.
    //
    // Kalau dokumen ini bisa dibaca, ujiannya jadi lelucon: kunci
    // jawabannya ada di dalam. Kalau bisa ditulis, `lockedUntil`
    // (jeda 24 jam setelah gagal) bisa dihapus sendiri oleh pemainnya.
    // Sengaja tidak ada allow apa pun di sini; diam berarti tolak.
    match /rankSkipExams/{uid} {
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Global Points internal state — the `pointsAwarded` idempotency
    // markers and `repeatCycles` decay counters `functions/
    // global_points.js` reads/writes inside its own transaction.
    // Deliberately its own TOP-LEVEL collection, not a subcollection
    // under `users/{uid}` — the `match /users/{uid} { match
    // /{document=**} { allow read, write: if owner } }` block above
    // grants full read/write on ANY subcollection path under a user's
    // own document, with no way to carve out an exception from inside
    // that same match tree (Firestore rules union multiple matching
    // blocks; a narrower `allow ... if false` elsewhere would not
    // override a broader grant already in effect). Putting this here
    // instead, sealed exactly like `rankSkipExams/{uid}` above, is the
    // only way to keep it genuinely out of the client's reach: a
    // learner able to write their own `repeatCycles` doc could reset
    // their own decay counter to `n=1` before every attempt and defeat
    // the entire anti-farming design; able to write `pointsAwarded`,
    // could fabricate a marker to hide an attempt from a later audit,
    // or delete a real one to trigger a double-award on retry.
    match /globalPointsState/{uid} {
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Leaderboard — semua bisa baca, hanya bisa tulis data sendiri.
    //
    // Lima field `cardGame*` (tingkat/divisi/bintang/musim/total bintang
    // Mode Game Card, dimirror dari `users/{uid}.cardGameRank` oleh
    // `functions/battle_stars.js`) TIDAK BOLEH diubah oleh client —
    // persis alasan yang sama seperti kunci `cardGameRank` di
    // `users/{uid}` di atas: tanpa ini, papan peringkat bintang cuma
    // hiasan, siapa saja bisa menulis langsung ke dokumen leaderboard
    // miliknya sendiri dan naik ke puncak tanpa bertanding sekali pun.
    // Dipecah jadi create/update terpisah (bukan satu `write`) meniru
    // pola yang sama di `users/{uid}` — create melarang field itu MUNCUL
    // sama sekali (`ensurePublished` memang tidak pernah menyertakannya),
    // update membandingkan nilai sebelum vs. sesudah, sama-sama supaya
    // penulisan lain yang tidak berkaitan (nama, avatar, skor ujian)
    // tetap bisa lewat `set(merge:true)` tanpa terblokir.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      // `globalPoints` (Top Global's ranking number, Formula C — see
      // functions/global_points.js) is locked the exact same way as the
      // five `cardGame*` fields right below it, for the exact same
      // reason: its only writer is a Cloud Function
      // (onKanaExamHistoryCreated and its three siblings), running with
      // Admin SDK privileges that don't go through this file at all.
      // Without this lock the whole point of Formula C's anti-farming
      // design (repeat-cycle decay, computed only inside the trigger) is
      // decorative — any client could just write any number here
      // directly. `globalPointsUpdatedAt` travels with it since it's
      // meaningless without the value it timestamps.
      allow create: if request.auth != null && request.auth.uid == uid
          && !('cardGameTier' in request.resource.data)
          && !('cardGameDivision' in request.resource.data)
          && !('cardGameStars' in request.resource.data)
          && !('cardGameSeason' in request.resource.data)
          && !('cardGameStarTotal' in request.resource.data)
          && !('globalPoints' in request.resource.data)
          && !('globalPointsUpdatedAt' in request.resource.data)
          // RISK-2 — see mirrorsOwnCosmetics's own doc comment: this mirror
          // must never show a cosmetic the writer doesn't actually own.
          && mirrorsOwnCosmetics(uid);
      allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.get('cardGameTier', null)
              == resource.data.get('cardGameTier', null)
          && request.resource.data.get('cardGameDivision', null)
              == resource.data.get('cardGameDivision', null)
          && request.resource.data.get('cardGameStars', null)
              == resource.data.get('cardGameStars', null)
          && request.resource.data.get('cardGameSeason', null)
              == resource.data.get('cardGameSeason', null)
          && request.resource.data.get('cardGameStarTotal', null)
              == resource.data.get('cardGameStarTotal', null)
          && request.resource.data.get('globalPoints', null)
              == resource.data.get('globalPoints', null)
          && request.resource.data.get('globalPointsUpdatedAt', null)
              == resource.data.get('globalPointsUpdatedAt', null)
          // RISK-2 — see mirrorsOwnCosmetics's own doc comment.
          && mirrorsOwnCosmetics(uid);
      // Sengaja tidak ada `allow delete` juga — beda dari `users/{uid}`
      // di atas, rule lama di sini (satu `allow write` polos) memang
      // sudah membolehkan hapus-sendiri sejak awal, jadi ini bukan
      // regresi dari perubahan Mode Game Card, tapi celah lama yang
      // baru ditutup sekalian saat berada di file ini: tidak ada fitur
      // yang pernah menghapus dokumen leaderboard sendiri, dan
      // menghapusnya berarti hilang dari papan peringkat tanpa jejak.
    }

    // Weekly Global Ranking — P0 fix (see functions/award_top_coins.js's
    // own top-of-file doc comment for the full incident writeup).
    //
    // `leaderboard/{uid}.globalScore` (right above) has no write
    // restriction at all — any signed-in user can set it to anything —
    // and `functions/award_top_coins.js` used to rank a real weekly coin
    // payout directly off that field with no server-side check. The fix
    // is a new ranking SOURCE, not a rules patch on `globalScore` itself:
    // `globalScorePeriods/{periodId}/users/{uid}` is written **only**
    // inside `global_points.js`'s `awardPointsForHistoryDoc` transaction
    // (Admin SDK, server-derived period id from the triggering
    // CloudEvent's own `event.time` — never a client-supplied value), so
    // there is no client write path to sanitize here: every write is
    // denied outright, full stop, for every field, always. Reads stay
    // open to any signed-in user, matching `leaderboard/{uid}`'s own
    // read rule — this is public ranking data, same trust level as the
    // rest of the leaderboard.
    match /globalScorePeriods/{periodId}/users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The historical payout record for one closed weekly period —
    // written **only** by `award_top_coins.js`'s `awardTopGlobalCoinsOnce`
    // (Admin SDK, inside its own idempotency-guarding transaction).
    // Same reasoning as `globalScorePeriods` above: no legitimate client
    // write path exists at all, so every write is denied unconditionally.
    // Reads stay open — a `winners` list naming who placed 1st-3rd for a
    // past week is exactly the kind of thing this app's own public
    // leaderboard/profile surfaces already show freely (see
    // `PublicProfileScreen`).
    match /globalScorePeriodAwards/{periodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Trusted exam-grading result — Exam-History Authority fix (see
    // TEISOU_ROADMAP_MASTER.md's "Exam-History Authority" audit + design
    // + implementation sections). The raw, client-writable
    // `examHistory`/`dokkaiExamHistory`/`choukaiExamHistory`/
    // `kanjiComboExamHistory` documents (covered by the generic
    // `users/{uid}/{document=**}` owner-write wildcard below, and
    // DELIBERATELY left unconstrained by this fix — see this rules
    // file's own history for why an unvalidated raw submission stays
    // functional: content honesty is enforced downstream by re-grading,
    // not by locking the raw write) still carry a client-reported
    // `score`/`total` that Cloud Functions no longer trusts for anything
    // monetary. `examHistoryGraded/{historyDocId}` is the trusted,
    // server-only result of independently re-grading that raw submission
    // against this project's own bundled content
    // (`functions/exam_grading.js`), written exactly once per
    // `historyDocId` inside `global_points.js`'s
    // `awardPointsForHistoryDoc` transaction — same reasoning as
    // `globalScorePeriods` above: there is no legitimate client write
    // path at all, so every write is denied unconditionally, for every
    // field, always. Reads are owner-only (not public like
    // `globalScorePeriods`) since this doc's own `uid` field lets it
    // double as a per-user audit trail of what the server actually
    // graded, which has no reason to be world-readable the way a public
    // ranking number does.
    match /examHistoryGraded/{historyDocId} {
      allow read: if request.auth != null
          && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // `leaderboard/{uid}.globalScore` itself is DELIBERATELY left
    // unrestricted by this implementation — evaluated and explicitly
    // rejected, not an oversight:
    //   1. The approved Weekly Global Ranking design explicitly keeps
    //      `globalScore`'s existing semantics unchanged ("remains
    //      historical, does NOT reset") with no instruction to restrict
    //      its writes — only to stop USING it for the payout.
    //   2. The new payout reads exclusively from `globalScorePeriods`
    //      above; a forged `globalScore` has zero influence on it
    //      (proven directly by
    //      `functions/award_top_coins_period.test.js`'s "a stale/
    //      unprotected leaderboard.globalScore value... has ZERO
    //      influence on ranking" test). Freezing it would not close any
    //      gap this P0 is about — the gap it used to enable (a forged
    //      ranking number driving a real money payout) is already fully
    //      closed by the ranking-source change above, independent of
    //      whether this field is ever locked down.
    //   3. The residual risk `globalScore`'s writability still carries —
    //      a user could inflate their own displayed "Skor Global" tab
    //      rank with a fabricated number — is a pre-existing display/
    //      social-integrity concern, unrelated to and no worse than it
    //      was before this change. Tightening it is a legitimate future
    //      hardening task, but a separate, deliberately-scoped one — not
    //      bundled into this P0 fix per this task's own explicit
    //      instruction not to revisit approved architecture without a
    //      concrete blocker.

    // Reservasi ID unik per user (ProgressRepository._reserveUserId) — id
    // dokumen itu sendiri ADALAH kode uniknya, sama seperti kode gabung
    // clan memakai id dokumen clan. Dibaca (exists) saat generate untuk
    // cek tabrakan sebelum dipakai; ditulis sekali saat profil pertama
    // dibuat atau saat akun lama di-backfill. Tidak ada update/delete —
    // reservasi ini permanen selama akun pemiliknya ada.
    match /userIds/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
    }

    // Penanda permanen "akun ini sudah pernah membuat clan" — id dokumen
    // adalah uid pembuatnya. SENGAJA di level teratas, BUKAN di bawah
    // users/{uid}, supaya lolos dari wildcard users/{uid}/{document=**}
    // yang mengizinkan pemilik akun menulis (dan MENGHAPUS) apa saja di
    // bawah dokumennya sendiri — kalau penanda ini ada di sana, akun yang
    // sama bisa menghapusnya lalu membuat clan gratis lagi. Hanya boleh
    // `create`, tidak pernah `update`/`delete` (default ditolak karena
    // tidak dituliskan) — begitu ada, keberadaannya sendiri sudah cukup
    // sebagai bukti "jatah gratis sudah dipakai", permanen selama akun itu
    // ada, dan tidak bisa dicabut siapa pun termasuk pemiliknya sendiri.
    match /clanFreeSlotUsed/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // Clans — siapa saja yang login bisa baca (cari lewat kode join, lihat
    // ranking anggota). Membuat clan hanya boleh kalau hostUid == diri
    // sendiri, DAN hanya kalau canCreateClan mengizinkan — 1 clan pertama
    // gratis untuk setiap akun (lihat clanFreeSlotUsed di atas), clan
    // berikutnya butuh langganan premium aktif atau satu tontonan iklan
    // reward yang belum dipakai (adRewards.clan_extra, pola yang sama
    // dengan gate premium avatar/sampul/bingkai — lihat isAllowedAvatarWrite
    // di bawah). Mengubah dokumen clan setelah dibuat hanya boleh oleh host
    // (mis. nanti kalau ada fitur rename), KECUALI perubahan yang hanya
    // menyentuh `memberCount`/`totalScore`/`lastReadAt` — ketiganya boleh
    // ditulis siapa saja yang login (bukan cuma anggota clan itu),
    // mengikuti pola yang sudah ada untuk `memberCount` sebelum fitur ini:
    // kepercayaan yang sama seperti `leaderboard/{uid}.globalScore`, yang
    // juga bisa ditulis apa saja oleh pemiliknya tanpa validasi server-side
    // atas angka yang ditulis. `lastReadAt` sengaja hanya menyimpan
    // penanda waktu "kapan user X terakhir baca chat", bukan isi pesan
    // sama sekali — chat clan yang sesungguhnya tetap hanya bisa dibaca
    // anggota clan itu lewat rule `isClanMember` di subcollection
    // `messages` di bawah, supaya batas privasi chat clan yang sudah ada
    // sejak awal tidak melebar hanya karena dokumen clan-nya sendiri
    // publik. Tidak ada Cloud Functions di proyek ini untuk memvalidasi
    // agregat semacam ini, jadi ini kelonggaran yang sudah diterima
    // desainnya, bukan celah baru.
    match /clans/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.hostUid == request.auth.uid
          && canCreateClan(request.auth.uid);
      allow update: if request.auth != null
          && (resource.data.hostUid == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['memberCount', 'totalScore', 'lastReadAt', 'announcementLastReadAt']));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Roster — siapa saja yang login bisa baca daftar anggota. Menulis
      // baris sendiri selalu boleh (join, atau sinkron nama/avatar).
      // Mengubah baris ORANG LAIN hanya boleh leader, dan hanya field
      // `role` (promosi/turunkan co-leader) — leadership sendiri (siapa
      // host) tidak bisa diubah lewat sini. Menghapus baris orang lain
      // (tendang) boleh leader (siapa saja kecuali dirinya sendiri) atau
      // co-leader (hanya anggota biasa, bukan leader/co-leader lain).
      match /members/{memberUid} {
        allow read: if request.auth != null;
        // RISK-2 — own-row create/update must mirror avatarType/
        // avatarValue exactly as they stand on the writer's own
        // users/{uid}.profile right now; see mirrorsOwnCosmetics's own
        // doc comment. `request.resource == null` is a delete (leaving
        // the clan) — unaffected by this check, same as before.
        // Core Clan Mechanics audit (2026-08-28), BUG #2: neither rule
        // below used to check the VALUE written to `role` at all — only
        // that the write's cosmetics matched (own-row) or that `role`
        // was the sole changed key (leader-updates-another-row). A
        // member could self-elevate by editing their own existing
        // roster row, or a real leader's promote action could be
        // trusted to write any value including a fabricated 'leader'
        // onto someone else. `actorRole()` above now makes a forged
        // stored 'leader' harmless for AUTHORIZATION on a non-host uid,
        // but that's a second line of defense, not a reason to leave the
        // data itself writable to a lie — these two checks stop the
        // fabricated value from ever being written in the first place.
        allow write: if request.auth != null && request.auth.uid == memberUid
            && (request.resource == null
                || (mirrorsOwnCosmetics(memberUid)
                    // A brand-new row (join, or the host's own row at
                    // clan creation) may carry whatever role the Dart
                    // model constructed it with — `createClan`'s own
                    // separate rule on the clans/{code} doc already
                    // guarantees hostUid == request.auth.uid for the
                    // create-clan case, and joinClan always constructs
                    // a fresh member with role 'member'. What matters
                    // here is the EXISTING-row case: nothing about a
                    // self-write may ever change `role` — an existing
                    // member's own row can never rewrite its own role,
                    // whatever it currently is, closing the direct
                    // self-elevation path.
                    && (resource == null
                        || request.resource.data.role == resource.data.role)));
        allow update: if request.auth != null
            && request.auth.uid != memberUid
            && actorRole(code, request.auth.uid) == 'leader'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['member', 'coLeader'];
        allow delete: if request.auth != null
            && request.auth.uid != memberUid
            && canKick(code, request.auth.uid, memberUid);
      }

      // Chat clan — beda dari roster/leaderboard di atas, ini SENGAJA
      // dibatasi ketat: hanya anggota clan itu sendiri yang boleh baca
      // atau menulis (bukan siapa saja yang login), karena ini isi pesan
      // sungguhan, bukan sekadar angka skor. Tidak ada update/delete sama
      // sekali — pesan tidak bisa diedit atau dihapus setelah terkirim,
      // supaya pesan yang sudah dilaporkan tidak bisa diam-diam diubah.
      match /messages/{messageId} {
        allow read: if request.auth != null && isClanMember(code, request.auth.uid);
        allow create: if request.auth != null
            && isClanMember(code, request.auth.uid)
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 300;
      }

      // Pengumuman clan — beda dari chat di atas: hanya LEADER yang boleh
      // membuat (bukan sekadar anggota, dan sengaja bukan co-leader juga —
      // "actorRole == leader", bukan "isClanMember" atau ikut daftar
      // co-leader yang dipakai undangan), tapi semua anggota boleh membaca.
      // Tidak ada update/delete, sama seperti chat: sekali diumumkan, tidak
      // bisa diam-diam diubah. Push notification ke setiap anggota dikirim
      // dari Cloud Function `onClanAnnouncementCreated` (Admin SDK, lewat
      // users/{uid}/notifications), bukan dari sini.
      match /announcements/{announcementId} {
        allow read: if request.auth != null && isClanMember(code, request.auth.uid);
        allow create: if request.auth != null
            && actorRole(code, request.auth.uid) == 'leader'
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500;
      }
    }

    // Undangan clan — hanya pemiliknya (target undangan) yang bisa baca/
    // menjawabnya, lewat wildcard `users/{uid}/{document=**}` di atas.
    // Blok ini menambah SATU izin baru: leader/co-leader boleh MEMBUAT
    // undangan di bawah user lain (bukan dirinya sendiri), yang tidak
    // dicakup wildcard itu karena `request.auth.uid != targetUid` di sini.
    match /users/{targetUid}/clanInvites/{inviteId} {
      allow create: if request.auth != null
          && request.resource.data.invitedByUid == request.auth.uid
          && (actorRole(request.resource.data.code, request.auth.uid) == 'leader'
              || actorRole(request.resource.data.code, request.auth.uid) == 'coLeader');
    }

    // Sama seperti undangan di atas: wildcard `users/{uid}/{document=**}`
    // sudah mengizinkan pemilik menghapus keanggotaannya sendiri (keluar
    // clan). Blok ini menambah izin bagi leader/co-leader yang MENENDANG
    // orang lain untuk juga menghapus baris reverse-index milik target —
    // tanpa ini, target yang ditendang tetap melihat clan itu di daftar
    // "clan saya" sendiri walau baris rosternya sudah dihapus.
    match /users/{targetUid}/clanMemberships/{code} {
      allow delete: if request.auth != null
          && canKick(code, request.auth.uid, targetUid);
    }

    // Permintaan pertemanan — hanya pemiliknya (target) yang bisa membaca/
    // menjawabnya, lewat wildcard `users/{uid}/{document=**}` di atas. Blok
    // ini menambah SATU izin baru: siapa saja yang login boleh MEMBUAT
    // permintaan di bawah user lain (bukan dirinya sendiri), asalkan
    // `fromUid` di dalam datanya cocok dengan identitas si pengirim —
    // itulah yang mencegah seseorang membuat permintaan atas nama orang
    // lain. Tidak ada validasi "belum berteman"/"belum ada permintaan
    // pending" di sini secara sengaja — itu cuma pengecekan awal di sisi
    // client (`FriendRepository.sendFriendRequest`); yang paling buruk
    // kalau dilewati cuma dokumen permintaan ganda, bukan celah keamanan.
    match /users/{targetUid}/friendRequests/{requestId} {
      allow create: if request.auth != null
          && request.auth.uid != targetUid
          && request.resource.data.fromUid == request.auth.uid;
    }

    // Card Game Mode "Tantang" challenge (see NOTES_CARD_GAME_MODE.md's
    // "Cara mengundang teman/clan bertanding"). Same shape as
    // `friendRequests` above — the target can read/answer it via the
    // `users/{uid}/{document=**}` wildcard, so this block only adds the
    // two permissions that wildcard doesn't cover: creating a document
    // under someone else's subcollection, and the *sender* later
    // retracting it. Unlike `clanInvites`/`friendRequests`, `create`
    // also checks that `matchId` really does point at a `battleMatches`
    // doc that already has both the sender and the target in its
    // `players` — the invite is a pointer to an already-created match
    // (see `BattleInvite.matchId`'s own doc comment for why), so this is
    // what stops a signed-in user from writing an invite that dangles or
    // points at somebody else's unrelated match.
    //
    // `update` is the sender cancelling their own sent challenge
    // (`BattleInviteWaitingScreen`'s Batal button, and its own
    // `dispose()` — leaving that screen any other way also retracts it).
    // Without this, `respondToMatchInvite` alone only updates the
    // `battleMatches` doc, never this one — the target reads *this*
    // document, not that one, so a cancelled challenge's row stayed
    // stuck showing "menantangmu" forever on the target's side, with no
    // permission to fix it since the sender isn't `targetUid` and so
    // isn't covered by the wildcard above. Scoped to `status ==
    // 'declined'` only — a sender can retract, never fabricate an
    // acceptance on the target's behalf.
    match /users/{targetUid}/battleInvites/{inviteId} {
      allow create: if request.auth != null
          && request.auth.uid != targetUid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.matchId is string
          && matchHasBothPlayers(
              request.resource.data.matchId, request.auth.uid, targetUid);
      allow update: if request.auth != null
          && request.auth.uid == resource.data.fromUid
          && request.resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status']);
    }

    function matchHasBothPlayers(matchId, a, b) {
      let players =
          get(/databases/$(database)/documents/battleMatches/$(matchId)).data.players;
      return a in players && b in players;
    }

    // [uid]'s current Card Game Mode tier, straight from `users/{uid}`
    // (the same field `functions/battle_stars.js` reads/writes) — used
    // by `battleMatches`' create rule to verify a client-asserted ranked
    // match's `cardTierContent` actually matches the tier it claims.
    function cardGameTierOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
          .get('cardGameRank', {}).get('tier', 'bronze');
    }

    // Mirrors card_game_rank.dart's CardGameTierX.cardContent /
    // functions/battle_bot.js's DIFFICULTY keys — "Isi kartu ditentukan
    // oleh rank" as a lookup, kept here so `battleMatches`' create rule
    // can enforce it server-side instead of trusting a client's own
    // `cardTierContent` string.
    function cardContentForTier(tier) {
      return tier == 'silver' ? 'katakanaAndKanaCombo'
          : tier == 'gold' ? 'kanjiN5'
          : tier == 'diamond' ? 'kanjiN4N3'
          : tier == 'emerald' ? 'kanjiN2N1'
          : 'hiragana';
    }

    // Daftar teman — setiap baris `friends/{friendUid}` merepresentasikan
    // SATU orang (uid dokumennya). Siapa saja yang login boleh menulis
    // barisnya SENDIRI di dalam koleksi `friends` milik SIAPA SAJA (bukan
    // cuma miliknya sendiri) — inilah yang memungkinkan dua alur: (1) saat
    // menerima permintaan pertemanan, penerima menulis baris dirinya
    // sendiri ke dalam `friends` milik si pengirim (begitu juga
    // sebaliknya, dua tulisan sekaligus dalam satu batch); (2) saat
    // menghapus pertemanan, masing-masing pihak menghapus barisnya sendiri
    // dari koleksi `friends` milik pihak lain. Baris milik SENDIRI di
    // dalam koleksi `friends` milik diri sendiri sudah dicakup wildcard
    // `users/{uid}/{document=**}` di atas — blok ini murni menambah izin
    // untuk menyentuh koleksi `friends` milik ORANG LAIN, dan hanya baris
    // yang mewakili diri sendiri, tidak pernah baris pihak ketiga.
    match /users/{otherUid}/friends/{friendUid} {
      // RISK-2 — this row represents [friendUid]'s own identity as seen
      // by [otherUid], a real other person; see mirrorsOwnCosmetics's
      // own doc comment. `request.resource == null` is a delete
      // (unfriending), unaffected by this check, same as before.
      //
      // Deliberately NOT extended to the mirrored write into one's OWN
      // friends list (`users/{myUid}/friends/{otherUid}`, covered by the
      // generic `{subcollection}/{document=**}` wildcard above, not this
      // block) — that row is only ever readable by its owner (`myUid`),
      // so a fake avatarType/avatarValue there could only mislead the
      // writer about their own friend, never another real person. No
      // externally-observable impact, so left out of this fix's scope
      // rather than restructuring a wildcard dozens of unrelated
      // subcollections also rely on.
      allow write: if request.auth != null && request.auth.uid == friendUid
          && (request.resource == null || mirrorsOwnCosmetics(friendUid));
    }

    // Chat pribadi 1:1 antar teman — beda dari chat clan (yang cukup
    // sama-sama anggota clan), ini mensyaratkan pertemanan yang sudah
    // disetujui KEDUA belah pihak (lihat isFriend di bawah), dicek ulang
    // setiap kali baca/tulis, bukan cuma sekali saat percakapan dibuat.
    // Jadi begitu salah satu pihak menghapus pertemanan, percakapan lama
    // langsung tidak bisa diakses lagi oleh siapa pun — bukan cuma
    // disembunyikan di sisi client seperti blokir di chat clan.
    match /directMessages/{conversationId} {
      allow read: if request.auth != null
          && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants
          && isFriend(request.resource.data.participants[0],
              request.resource.data.participants[1]);
      allow update: if request.auth != null
          && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants;
        allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 300;
      }
    }

    function isFriend(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
    }

    // Boleh membuat clan baru kalau: belum pernah membuat clan sama sekali
    // (belum ada clanFreeSlotUsed/{uid}), ATAU langganannya premium, ATAU
    // sedang punya reward iklan aktif untuk modul 'clan_extra' yang belum
    // dipakai. Ketiganya di-OR-kan, bukan disyaratkan sekaligus — jatah
    // gratis hanya dicek kalau memang belum pernah dipakai; begitu sudah
    // dipakai sekali, baru dua kondisi lain yang menentukan.
    function canCreateClan(uid) {
      return !exists(/databases/$(database)/documents/clanFreeSlotUsed/$(uid))
          || isPremiumUser(uid)
          || hasActiveClanAdReward(uid);
    }

    function isPremiumUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
          .get('subscription', {}).get('tier', 'free') == 'premium';
    }

    // Meniru AdReward.isActive (lib/data/models/ad_reward.dart) di sisi
    // server: reward dianggap aktif kalau field 'clan_extra' ada di dalam
    // map adRewards DAN expiresAt-nya masih di masa depan.
    function hasActiveClanAdReward(uid) {
      let rewards =
          get(/databases/$(database)/documents/users/$(uid)).data.get('adRewards', {});
      return ('clan_extra' in rewards) && rewards.clan_extra.expiresAt > request.time;
    }

    // Peran (role) satu anggota di satu clan — 'leader'/'coLeader'/'member'.
    // Baris lama yang ditulis sebelum field `role` ada dianggap 'leader'
    // kalau uid-nya cocok dengan `hostUid` clan itu, 'member' kalau tidak —
    // supaya clan yang sudah ada sebelum fitur ini tidak mendadak
    // kehilangan siapa leadernya.
    function isClanMember(code, uid) {
      return exists(/databases/$(database)/documents/clans/$(code)/members/$(uid));
    }

    // Core Clan Mechanics audit (2026-08-28), BUG #2: this used to trust
    // the STORED `role` field first and only fall back to `hostUid` when
    // `role` was absent — so any member could be handed (or write onto
    // their own row, see the `members/{memberUid}` `allow write` rule
    // below) a forged `role: 'leader'` value and be treated as a genuine
    // leader for every authorization check in this file (promote/demote,
    // kick, disband, invite-management, ...). Proven two ways against the
    // old function: a real leader legitimately updating ANOTHER member's
    // `role` (the `allow update` rule below never checked the VALUE being
    // written, only that `role` was the sole changed key) and a member
    // writing a forged `role` onto their OWN row via `allow write` (no
    // restriction on `role`'s value at all). Either path let the
    // recipient then kick the real leader out of their own clan.
    //
    // Fixed by making `hostUid` — the one field nothing here lets a
    // non-host ever set on themselves — the sole source of truth for
    // 'leader' status: a stored `role` of 'leader' is now only honored
    // when it came from the actual host; every other uid's stored role
    // is trusted for 'coLeader'/'member' (legitimate demotion/promotion
    // between those two still works exactly as before) but can never
    // read back as 'leader' no matter what value is written to it.
    function actorRole(code, uid) {
      let hostUid = get(/databases/$(database)/documents/clans/$(code)).data.hostUid;
      let memberPath = /databases/$(database)/documents/clans/$(code)/members/$(uid);
      let memberData = get(memberPath).data;
      let storedRole = ('role' in memberData) ? memberData.role : 'member';
      return uid == hostUid ? 'leader' : (storedRole == 'leader' ? 'member' : storedRole);
    }

    // Leader boleh menendang siapa saja kecuali dirinya sendiri (menendang
    // diri sendiri berarti keluar clan, jalur yang berbeda). Co-leader
    // hanya boleh menendang anggota biasa — tidak leader, tidak co-leader
    // lain — supaya sesama co-leader tidak bisa saling menendang.
    function canKick(code, actorUid, targetUid) {
      let actor = actorRole(code, actorUid);
      let target = actorRole(code, targetUid);
      return (actor == 'leader' && actorUid != targetUid)
          || (actor == 'coLeader' && target == 'member');
    }

    // Laporan pesan chat clan — tulis-saja dari sisi user, sengaja tidak
    // ada allow read/update/delete untuk user biasa sama sekali. Aplikasi
    // ini tidak punya panel admin, jadi laporan hanya bisa ditinjau manual
    // lewat Firebase Console — ini batas jujur dari apa yang bisa didukung
    // proyek ini sekarang, bukan fitur peninjauan yang belum selesai.
    match /messageReports/{reportId} {
      allow create: if request.auth != null
          && request.resource.data.reporterUid == request.auth.uid;
    }

    // Card Game Mode (see NOTES_CARD_GAME_MODE.md). Only the two players
    // in a match can read or write it — a match is never a public
    // spectacle. `officialScore`/`result`/`status`/`players`/`turnOrder`/
    // `scoredRounds`/`cardTierContent`/`rankedMatch` are locked to
    // Cloud-Function-or-creation-only: a client update that touches any
    // of them is rejected outright, since those are exactly the fields
    // that decide star movement (or the scoring/bot Cloud Functions'
    // own bookkeeping) and must never be settable by a client that
    // could lie about a win. The Cloud Functions themselves
    // (functions/battle_scoring.js, functions/battle_bot.js) run via the
    // Admin SDK, which bypasses these rules entirely, so they need no
    // special-casing here.
    match /battleMatches/{matchId} {
      allow read: if request.auth != null
          && request.auth.uid in resource.data.players;

      // A client-created match asserting `rankedMatch: true` used to be
      // trusted at face value, with nothing tying `cardTierContent` to
      // how the match was actually formed. That meant any signed-in
      // player could write a `battleMatches` doc directly — bypassing
      // the app entirely — with `cardTierContent: 'hiragana'` and
      // `rankedMatch: true` against `"BOT"`, regardless of their real
      // tier, and battle_stars.js would award real ranked stars for
      // winning at the easiest possible difficulty: exactly the "pilih
      // hiragana, naik ke Emerald tanpa pernah menyentuh kanji" shortcut
      // the notes already ruled out for *chosen* content, just reached
      // through a different door. A real player-vs-player ranked match
      // is only ever created server-side by
      // functions/battle_matchmaking.js (Admin SDK, bypasses these rules
      // entirely) — the only *client*-created ranked match is the "give
      // up waiting, fight the bot" fallback, which is always against the
      // `"BOT"` sentinel and always at the player's own current tier. So
      // a client asserting `rankedMatch: true` is only ever allowed
      // through that one exact shape.
      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.players
          && request.resource.data.players.size() == 2
          && request.resource.data.status == 'active'
          && request.resource.data.currentRound == 0
          && request.resource.data.result == null
          && request.resource.data.cardTierContent is string
          && request.resource.data.get('rankedMatch', true) is bool
          && (request.resource.data.get('rankedMatch', true) == false
              || ('BOT' in request.resource.data.players
                  && request.resource.data.cardTierContent ==
                      cardContentForTier(cardGameTierOf(request.auth.uid))));

      allow update: if request.auth != null
          && request.auth.uid in resource.data.players
          && request.resource.data.officialScore == resource.data.officialScore
          && request.resource.data.result == resource.data.result
          && request.resource.data.status == resource.data.status
          && request.resource.data.players == resource.data.players
          && request.resource.data.turnOrder == resource.data.turnOrder
          && request.resource.data.get('scoredRounds', {}) == resource.data.get('scoredRounds', {})
          && request.resource.data.get('cardTierContent', '') == resource.data.get('cardTierContent', '')
          && request.resource.data.get('rankedMatch', true) == resource.data.get('rankedMatch', true)
          // Stempel waktu pembuatan: dipakai layar hasil untuk menghitung
          // durasi. Ditulis sekali saat create; kalau client boleh
          // mengubahnya, durasi pertandingan bisa dikarang.
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          // Ditulis hanya oleh Cloud Function battle_stars.js (pergerakan
          // bintang hasil pertandingan ini). Kalau client boleh
          // menulisnya, layar hasil bisa dibuat mengaku naik bintang
          // sebanyak apa pun — dan karena itu satu-satunya yang dilihat
          // pemain, bohongnya tidak akan ketahuan.
          && request.resource.data.get('starResult', {}) == resource.data.get('starResult', {})
          // Penanda internal battle_stars.js (sudah/belum dibayar, dan
          // sudah berapa kali dicoba). Client tidak punya urusan dengan
          // keduanya, dan kalau bisa menulisnya, bintang satu
          // pertandingan bisa dibayar berkali-kali.
          && request.resource.data.get('starsApplied', false) == resource.data.get('starsApplied', false)
          && request.resource.data.get('starsAttempts', 0) == resource.data.get('starsAttempts', 0)
          // Kartu di tangan tiap pemain, ditulis sekali saat match
          // dibuat. `playedCards` (kartu yang dipilih tiap ronde) SENGAJA
          // tidak dibekukan — itu justru yang ditulis pemain tiap
          // giliran. Yang dibekukan adalah isi tangannya, supaya tidak
          // ada yang menukar kartunya di tengah pertandingan.
          && request.resource.data.get('decks', {}) == resource.data.get('decks', {});

      // Write-once — no update/delete, so a submitted answer can never
      // be edited after the fact. Deliberately NOT restricted to
      // `byUid == request.auth.uid`: a timeout is written by the
      // WAITING player forcing the turn to advance (see
      // NOTES_CARD_GAME_MODE.md's "Kalau lawan menutup aplikasi di
      // tengah pertandingan"), not by whoever the answer conceptually
      // belongs to. Safe to allow either player to write any round's
      // answer because `byUid`/`text` here are fast-path display
      // convenience only — the authoritative Cloud Function score
      // (Tahap 2 butir 7, not built yet) must derive who was supposed
      // to answer from `turnOrder[round]` itself, never trust this
      // field.
      match /answers/{round} {
        allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/battleMatches/$(matchId)).data.players;

        allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/battleMatches/$(matchId)).data.players;
      }
    }

    // Uang. `subscription`, `entitlements` dan `coins` HANYA boleh ditulis
    // Cloud Function (Admin SDK, melewati rules ini): `verifyPurchase` untuk
    // dua yang pertama, `verifyPurchase` (paket top-up koin) dan
    // `awardTopGlobalCoins` (hadiah mingguan top 1-3 Skor Global) untuk
    // `coins`. Sebelum ada yang dijual, field-field ini bisa ditulis
    // pemiliknya sendiri dan itu tidak berbahaya; begitu ada yang dijual
    // atau bisa didapat gratis, client yang bisa menulis nilainya sendiri
    // membuat seluruh verifikasi jadi sandiwara — sama seperti alasan
    // `cardGameRank` di atas tidak boleh ditulis client.
    //
    // `adRewards` ikut dibekukan di sini juga (Security & Monetization
    // Remediation Plan, Blocker #1/Phase 0), meski bukan "uang" secara
    // harfiah: field ini adalah bukti unlock 24 jam yang dipercaya penuh
    // oleh `moduleAccessProvider` (lib/features/paywall/module_access.dart)
    // untuk lima modul premium (particle/kaiwa/choukai/kanji/bunpou) dan
    // oleh `canCreateClan` untuk slot clan tambahan — client yang bisa
    // menulis field ini sendiri berarti bisa memberi dirinya sendiri akses
    // premium permanen tanpa nonton iklan sama sekali, persis sandiwara
    // yang sama seperti `coins`/`subscription` di atas. Penulis sah
    // satu-satunya, setelah Phase 0 diikuti dengan Cloud Function AdMob
    // SSV (belum ada di repo ini per rencana), adalah Cloud Function itu
    // sendiri lewat Admin SDK. Sampai Cloud Function itu ada, field ini
    // sengaja dibekukan total — grant iklan yang sudah aktif tetap bisa
    // DIBACA (lihat rule read di atas), hanya tidak bisa ditulis ulang
    // atau diperpanjang oleh client. Konsekuensi yang diterima secara
    // sadar: `unlockAdReward`/`consumeAdReward`
    // (lib/data/repositories/progress_repository.dart) akan mulai gagal
    // dengan `permission-denied` sampai Cloud Function penggantinya ada —
    // ini bukan bug, ini persis skenario "at the cost of temporarily
    // breaking the legitimate ad-reward flow" yang sudah disetujui di
    // rencana implementasi.
    //
    // `xp` ikut dibekukan total di sini juga (Security & Monetization
    // Remediation Plan, Blocker #2/Phase 1). Dulu `xp.totalXp` ditambah
    // langsung oleh client (`ProgressRepository.addXp`) dan
    // `xp.unlockedAvatarIds`/`unlockedFrameIds`/`unlockedCoverIds`
    // (bukti hadiah naik level, `claimLevelReward`) juga ditulis client
    // — field yang terakhir ini secara sengaja TIDAK dibekukan waktu
    // `spend_coins.js` pertama kali menulis ke sana, karena "cosmetic
    // yang didapat gratis dari main tidak pernah dianggap perlu
    // dilindungi". Alasan itu berhenti berlaku begitu Keputusan Produk
    // "Option A — Premium Exclusive" dikunci: hadiah naik level TIDAK
    // BOLEH pernah memberi item yang subscription-exclusive
    // (`AvatarPresets`/`FramePresets`/`CoverPresets.isPremiumOnly`), dan
    // menjaga aturan itu hanya berarti sesuatu kalau field yang mencatat
    // "item apa yang sudah didapat lewat XP" tidak bisa dipalsukan
    // client — persis sandiwara yang sama dengan `coins`/`adRewards` di
    // atas. Sekarang, setelah `claimLevelReward` pindah sepenuhnya ke
    // Cloud Function (`functions/award_xp.js`), tidak ada lagi penulis
    // client yang sah untuk field mana pun di bawah `xp` — makanya
    // seluruh map dibekukan sekaligus, bukan per-field seperti
    // `subscription`/`entitlements`, karena tidak ada pengecualian yang
    // perlu dijaga lagi. `globalPoints` (leaderboard/{uid}, sistem
    // ranking terpisah) TIDAK disentuh oleh rule ini sama sekali — lihat
    // catatan di leaderboard/{uid} bagian bawah file ini.
    function isAllowedPurchaseWrite() {
      let oldSub = resource == null
          ? {}
          : resource.data.get('subscription', {});
      let oldEnt = resource == null
          ? {}
          : resource.data.get('entitlements', {});
      let oldCoins = resource == null
          ? 0
          : resource.data.get('coins', 0);
      let oldRewards = resource == null
          ? {}
          : resource.data.get('adRewards', {});
      let oldXp = resource == null
          ? {}
          : resource.data.get('xp', {});
      return request.resource.data.get('subscription', {}) == oldSub
          && request.resource.data.get('entitlements', {}) == oldEnt
          && request.resource.data.get('coins', 0) == oldCoins
          && request.resource.data.get('adRewards', {}) == oldRewards
          && request.resource.data.get('xp', {}) == oldXp;
    }

    // Kepemilikan Avatar/Bingkai/Sampul (subscription-exclusive, ad-tier,
    // coin-tier) dan Card Skin — Security & Monetization Final
    // Implementation Plan, Blocker #3 / Phase 2.
    //
    // **Yang lama, `isAllowedAvatarWrite`, punya celah nyata, bukan cuma
    // teoretis.** Pengecekannya hanya aktif saat `avatarType` BERUBAH ke
    // nilai gated (`preset_premium`) — jadi menulis `avatarType:
    // 'preset_free'` bersamaan dengan `avatarValue: 'neko_astronaut'`
    // (id subscription-exclusive) tidak pernah menyentuh pengecekan itu
    // sama sekali, karena `newType` yang dikirim bukan `'preset_premium'`.
    // `profile.frameId`/`profile.coverId`/`profile.cardSkinId` bahkan
    // tidak punya pengecekan apa pun. Desain baru di bawah ini
    // memvalidasi berdasarkan NILAI id itu sendiri, bukan tipe yang
    // diklaim client — jadi kombinasi type/value yang tidak konsisten
    // tidak bisa lagi jadi jalan pintas.
    //
    // **Keputusan Produk final (Option A — Premium Exclusive, dikunci di
    // TEISOU_Premium_Cosmetic_Ownership_Product_Decision.md).** Item
    // subscription-exclusive HANYA bisa dimiliki lewat langganan Premium
    // yang aktif. `xp.unlocked*Ids` (ditulis oleh `claimXpReward`
    // ataupun `spend_coins.js`, server-authoritative sejak Phase 1) TIDAK
    // PERNAH menjadi bukti kepemilikan untuk id di kelompok ini —
    // [isAllowedCosmeticEquip] di bawah sengaja mengecualikan id
    // premium-only dari cabang `ownedPermanently`, bahkan sebagai
    // pertahanan berlapis kalau field itu suatu saat ternyata berisi id
    // yang seharusnya tidak mungkin ada di sana.
    function isPremiumSubscriberNow() {
      return resource != null
          && resource.data.get('subscription', {}).get('tier', 'free') == 'premium';
    }

    // [moduleId] adalah string yang sama persis dengan yang dipakai
    // `ProgressRepository.unlockAdReward`/`getAdRewards`
    // ('avatar_premium'/'frame_premium'/'cover_premium'). `adRewards`
    // sendiri sudah dibekukan total terhadap tulisan client (Phase 0),
    // jadi field ini aman dipercaya di sini — satu-satunya penulis yang
    // sah adalah Cloud Function verifikasi AdMob SSV yang direncanakan
    // di Phase 3, belum ada di repo ini.
    function isAdRewardActive(moduleId) {
      return resource != null
          && resource.data.get('adRewards', {}).get(moduleId, {})
              .get('expiresAt', request.time) > request.time;
    }

    // Pengecekan bersama untuk Avatar/Bingkai/Sampul — ketiganya punya
    // bentuk yang identik: satu id, empat kemungkinan tingkat (free/ad/
    // coin/subscription-exclusive).
    //
    // **Riwayat dua bug compiler/evaluator nyata di fungsi ini, keduanya
    // ditemukan lewat firestore_rules_tests/ (real Firestore Rules
    // Emulator), bukan source-inspection — dicatat di sini supaya tidak
    // terulang:**
    // 1. Versi 8-argumen pertama (oldValue, newValue, freeIds, adIds,
    //    coinIds, premiumOnlyIds, ownedIds, adModuleId) GAGAL di-compile
    //    sama sekali oleh compiler asli Firestore ("Maximum allowed
    //    function arguments of 7").
    // 2. Perbaikan pertama membungkus empat list id ('free'/'ad'/'coin'/
    //    'premiumOnly') jadi SATU MAP parameter ([tiers]) supaya turun ke
    //    5 argumen. Itu memang compile — tapi engine evaluasi Firestore
    //    Rules yang sesungguhnya melempar "Null value error" begitu
    //    field map itu (`tiers.free`, dst.) diakses di dalam fungsi,
    //    WALAUPUN map-nya jelas tidak null dan terisi benar. Dibuktikan
    //    lewat 15+ probe terisolasi (lihat riwayat commit): argumen
    //    bertipe LIST bekerja normal lintas batas pemanggilan fungsi,
    //    argumen bertipe MAP tidak. Ini murni batasan/bug engine
    //    evaluasi Firestore Rules, bukan kesalahan logika.
    //
    // **Desain final (di bawah)**: [freeIds]/[adIds]/[premiumOnlyIds]
    // dikirim sebagai TIGA parameter list terpisah (bukan satu map),
    // ditambah [ownedIds] — total 7 argumen, pas di batas maksimal
    // Firestore Rules. [coinIds] SENGAJA tidak lagi jadi parameter
    // sendiri — satu-satunya kegunaannya adalah ikut menentukan
    // `recognized` (id ini dikenal katalog manapun), dan itu tetap
    // benar walau dihilangkan: id coin-tier yang BELUM dimiliki tetap
    // ditolak lewat cabang manapun (bukan free/ad/premiumOnly, dan
    // `newValue in ownedIds` juga false), sedangkan id coin-tier yang
    // SUDAH dimiliki otomatis ikut `recognized` lewat keanggotaan di
    // [ownedIds] itu sendiri — hasil akhirnya identik dengan versi yang
    // masih membawa [coinIds] eksplisit, tanpa perlu argumen ke-8.
    // [ownedIds] adalah `xp.unlocked{Avatar,Frame,Cover}Ids` milik
    // pemanggil; katalog coin-tier lengkap (`neko_matcha` dst.) tetap
    // didokumentasikan di masing-masing fungsi pemanggil di bawah untuk
    // keterbacaan, walau tidak lagi dikirim sebagai argumen.
    //
    // `unchanged` membiarkan tulisan lain yang tidak berkaitan (ganti
    // nama, dst.) tetap lewat lewat `set(merge:true)` walau id yang
    // sudah tersimpan kebetulan tidak lagi memenuhi syarat (mis.
    // langganan baru saja berakhir) — persis alasan yang sama seperti
    // `changingToGated` di desain lama, hanya sekarang berbasis nilai.
    function isAllowedCosmeticEquip(
        oldValue, newValue, freeIds, adIds, premiumOnlyIds, ownedIds, adModuleId) {
      let unchanged = newValue == oldValue;
      let recognized = newValue in freeIds || newValue in adIds
          || newValue in premiumOnlyIds || newValue in ownedIds;
      let ownedPermanently = newValue in ownedIds && !(newValue in premiumOnlyIds);
      let adEligibleNow = newValue in adIds && isAdRewardActive(adModuleId);
      let premiumOk = newValue in premiumOnlyIds && isPremiumSubscriberNow();
      return newValue == null || unchanged || (recognized && (
          newValue in freeIds || ownedPermanently || adEligibleNow || premiumOk
      ));
    }

    function isAllowedAvatarWrite() {
      let oldValue = resource == null
          ? null
          : resource.data.get('profile', {}).get('avatarValue', null);
      let newValue = request.resource.data.get('profile', {}).get('avatarValue', null);
      let ownedIds = resource == null
          ? []
          : resource.data.get('xp', {}).get('unlockedAvatarIds', []);
      // Katalog coin-tier lengkap, untuk keterbacaan saja (lihat catatan
      // [coinIds] di atas isAllowedCosmeticEquip — tidak lagi dikirim
      // sebagai argumen): 'neko_artist', 'neko_graduate', 'neko_ninja',
      // 'neko_samurai', 'neko_kimono', 'neko_matcha', 'neko_sailor',
      // 'neko_detective', 'neko_musician', 'neko_winter', 'neko_forest'.
      return isAllowedCosmeticEquip(
          oldValue, newValue,
          ['neko_sensei', 'neko_cheerleader', 'neko_bookworm'],
          ['neko_chef', 'neko_sleepy', 'neko_traveler'],
          ['neko_astronaut', 'neko_gamer', 'neko_lion'],
          ownedIds, 'avatar_premium');
    }

    // `profile.frameId` dan `profile.coverId` — bentuknya identik dengan
    // avatar di atas, hanya field dan id catalog-nya beda. Digabung satu
    // fungsi (bukan dua terpisah) karena nama ini yang diminta secara
    // eksplisit di rencana implementasi.
    function isAllowedProfileWrite() {
      let oldFrame = resource == null
          ? null
          : resource.data.get('profile', {}).get('frameId', null);
      let newFrame = request.resource.data.get('profile', {}).get('frameId', null);
      let ownedFrames = resource == null
          ? []
          : resource.data.get('xp', {}).get('unlockedFrameIds', []);
      // Katalog coin-tier lengkap (lihat catatan [coinIds] di atas
      // isAllowedCosmeticEquip): 'frame_halloween', 'frame_night_sky',
      // 'frame_mushroom_fairy', 'frame_fairytale', 'frame_witch',
      // 'frame_music', 'frame_retro_pc', 'frame_calligraphy'.
      let frameOk = isAllowedCosmeticEquip(
          oldFrame, newFrame,
          ['frame_sakura_fuji', 'frame_sakura', 'frame_autumn', 'frame_winter'],
          ['frame_spring_garden', 'frame_ocean', 'frame_jungle', 'frame_cat'],
          ['frame_steampunk', 'frame_space', 'frame_gaming', 'frame_moon_crystal'],
          ownedFrames, 'frame_premium');

      let oldCover = resource == null
          ? null
          : resource.data.get('profile', {}).get('coverId', null);
      let newCover = request.resource.data.get('profile', {}).get('coverId', null);
      let ownedCovers = resource == null
          ? []
          : resource.data.get('xp', {}).get('unlockedCoverIds', []);
      // Katalog coin-tier lengkap (lihat catatan [coinIds] di atas
      // isAllowedCosmeticEquip): 'jungle_canopy', 'enchanted_forest',
      // 'art_studio', 'sumi_ink', 'pixel_game', 'steampunk_brass',
      // 'zodiac_night', 'magic_castle'.
      let coverOk = isAllowedCosmeticEquip(
          oldCover, newCover,
          ['sakura_dawn', 'autumn_leaves', 'spring_meadow', 'starry_night'],
          ['coral_reef', 'sunflower_field', 'library_books', 'cat_lover'],
          ['sacred_geometry', 'cyber_neon', 'outer_space'],
          ownedCovers, 'cover_premium');

      return frameOk && coverOk;
    }

    // Card Skin (`profile.cardSkinId`) — mekanisme kepemilikan yang SUDAH
    // ADA (`card_skins.dart`'s `isCardSkinUnlocked`, tidak diubah di sini,
    // hanya ditegakkan ulang di server): free selalu boleh; achievement
    // (Emas Kencana/Ungu Malam/Naga Hitam) butuh total bintang mencapai
    // ambangnya DAN Premium aktif, keduanya; paid (Awan Putih/Kota Neon/
    // Sakura Emas) butuh `entitlements.skins` (dibeli, uang atau koin)
    // ATAU Premium (dibundel gratis). Card Skin sengaja TIDAK pernah
    // masuk `claimLevelReward`'s reward pool (lihat award_xp.js — tidak
    // ada `XpRewardKind.skin`), dan baris ini tidak mengubah itu.
    // [starTotal] dibaca dari `leaderboard/{uid}.cardGameStarTotal`
    // (dokumen terpisah, sudah dibekukan terhadap tulisan client di atas)
    // — bukan dari `users/{uid}.cardGameRank` secara langsung, mencerminkan
    // `isCardSkinUnlocked`'s sendiri doc comment yang bilang begitu.
    function cardSkinStarsRequired(skinId) {
      return skinId == 'emas_kencana' ? 35
          : (skinId == 'night_purple' ? 60
          : (skinId == 'dragon_black' ? 90 : 999999));
    }

    function isAllowedCardSkinWrite() {
      let oldSkin = resource == null
          ? null
          : resource.data.get('profile', {}).get('cardSkinId', null);
      let newSkin = request.resource.data.get('profile', {}).get('cardSkinId', null);
      let unchanged = newSkin == oldSkin;
      let freeIds = ['classic', 'sakura', 'indigo'];
      let achievementIds = ['emas_kencana', 'night_purple', 'dragon_black'];
      let paidIds = ['cloud_white', 'neon_city', 'sakura_gold'];
      let recognized = newSkin in freeIds || newSkin in achievementIds || newSkin in paidIds;
      // `get()` hanya benar-benar dievaluasi saat `newSkin` memang salah
      // satu id achievement — `&&` di Firestore Rules short-circuit,
      // jadi tulisan lain yang tidak berkaitan tidak membayar biaya baca
      // dokumen tambahan ini.
      let achievementOk = newSkin in achievementIds
          && get(/databases/$(database)/documents/leaderboard/$(resource.id))
              .data.get('cardGameStarTotal', 0) >= cardSkinStarsRequired(newSkin)
          && isPremiumSubscriberNow();
      let owned = resource != null
          && newSkin in resource.data.get('entitlements', {}).get('skins', []);
      let paidOk = newSkin in paidIds && (owned || isPremiumSubscriberNow());
      return newSkin == null || unchanged || (recognized && (
          newSkin in freeIds || achievementOk || paidOk
      ));
    }

    // RISK-2 (AUDIT_COSMETIC_PROFILE_SHOP.md). `leaderboard/{uid}`,
    // `clans/{code}/members/{uid}`, and
    // `users/{otherUid}/friends/{friendUid}` are pure denormalized
    // MIRRORS of `users/{uid}.profile`'s already-server-validated
    // cosmetic fields — every render site that shows someone ELSE's
    // avatar/frame/cover/card skin (`LeaderboardAvatar`, an opponent's
    // card back during a live match, `PublicProfileScreen`, clan/friends
    // rows) trusts whatever sits on the mirror directly, with no live
    // re-check against the writer's real entitlement.
    // `battle_screen.dart`'s own `_skinFor` doc comment says this is
    // "sound because `isAllowedCardSkinWrite` already refuses to let
    // that id become anything the opponent wasn't entitled to" — that
    // was never actually true, since `isAllowedCardSkinWrite` (and the
    // avatar/frame/cover equivalents) were only ever wired into `allow
    // update` on `users/{uid}` itself, never into any of these three
    // mirror collections. Proven via the real Firestore Rules Emulator
    // (`firestore_rules_tests/rules.test.js`'s "leaderboard/clan/friends
    // mirrors" group) before this function existed: a client could
    // write ANY avatarType/avatarValue/frameId/coverId/cardSkinId
    // directly onto their own row in any of the three, no ownership
    // required at all.
    //
    // Rather than re-implementing `isAllowedCosmeticEquip`'s whole
    // four-tier check three more times against a second document (and
    // risking it drifting out of sync with the real one as tiers
    // change), this ties every mirror write to the one place ownership
    // is already correctly and exclusively enforced: the resulting
    // avatarType/avatarValue/frameId/coverId/cardSkinId must equal
    // EXACTLY what [uid]'s own `users/{uid}` document says right now —
    // never a value the mirror write itself asserts. A field a given
    // mirror never carries (e.g. `frameId` on a `friends/` row) passes
    // trivially, since its "current value" and its own missing-field
    // default are the same `null` either way.
    function mirrorsOwnCosmetics(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data
          .get('profile', {});
      return request.resource.data.get('avatarType', p.get('avatarType', null))
              == p.get('avatarType', null)
          && request.resource.data.get('avatarValue', p.get('avatarValue', null))
              == p.get('avatarValue', null)
          && request.resource.data.get('frameId', p.get('frameId', null))
              == p.get('frameId', null)
          && request.resource.data.get('coverId', p.get('coverId', null))
              == p.get('coverId', null)
          && request.resource.data.get('cardSkinId', p.get('cardSkinId', null))
              == p.get('cardSkinId', null);
    }
  }
}
