{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline')"
      }
    },
    "matchmakingQueue": {
      "$tier": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChild('joinedAt') && newData.child('joinedAt').isNumber() && newData.child('joinedAt').val() <= now"
        }
      }
    },
    "matchmakingResults": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChild('matchId') && newData.child('matchId').isString()"
      }
    }
  }
}
